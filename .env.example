APP_ENV=production

DB_HOST=127.0.0.1
DB_DATABASE=digitalm_mi_ecommerce
DB_USERNAME=forge
DB_PASSWORD=

SESSION_NAME=ADMIN_MI_COMMERCE_WEB
SESSION_LIFETIME=7200
RUNFOOD_SESSION_NAME=ADMIN_FEED_CREW

PATH_HOSTING=/home/forge

# current cambia en cada deploy. Los archivos van en shared; el deploy enlaza
# current/assets/empresas hacia esa carpeta para que la URL pública siga igual.
URL_SISTEMA=https://dashboard.tastelatam.com/
URL_UPLOAD=/home/forge/dashboard.tastelatam.com/shared
URL_PAGES_INSTALLERS=https://dashboard.tastelatam.com/replicador/zip/
URL_FOLDER_DEMO=/home/forge/dashboard.tastelatam.com/shared/assets/demos/
FIREBASE_MESSAGING_TOKEN=
URL_LAAR=https://api.laarcourier.com:9727/

# URLs sin slash final (las usa el JS del dashboard)
API_TASTE_URL=https://api.mie-commerce.com/gestion-ordenes
API_TASTE_ECOMMERCE=https://api.mie-commerce.com/taste-front/v2
API_MOTORIZADOS_URL=https://api.mie-commerce.com/motorizados/v1
API_FLOTAS_URL=https://api.mie-commerce.com/flotas/v1
API_POS_URL=https://api.mie-commerce.com/pos/v3

# Mismo valor que TRACKING_SECRET en api/config.php y api_gestion_ordenes/config.php (entre comillas dobles)
TRACKING_SECRET=

# API de la app de motorizados (/api/riders/v1, carpeta api/riders). Mismos nombres que el dashboard nuevo (config/riders.php).
# Todos son opcionales: estos son los valores por defecto.
# RIDERS_GEOFENCE_STORE_METERS=100
# RIDERS_GEOFENCE_CUSTOMER_METERS=600
# RIDERS_FAR_STORE_METERS=300
# RIDERS_FAR_CUSTOMER_METERS=500
# RIDERS_LOCATION_FRESH_MINUTES=10
RIDERS_APP_PHONE=
RIDERS_APP_EMAIL=
RIDERS_APP_ADDRESS=
# La versión de la app sale de Versiones de app (cod_empresa 1); esta url se usa si la fila no trae una
RIDERS_APP_ANDROID_URL=
# webClientId de Google de la app (brand.json); varios separados por coma
# RIDERS_GOOGLE_CLIENT_IDS=407406159229-1rbmeedhilsdfvmufln0p76or04hnc7k.apps.googleusercontent.com
# En un entorno con una copia de producción poner 0: no envía push a clientes ni escribe en el Firebase de producción
# EXPO_PUSH_URL=0
# RIDERS_FIREBASE_PROJECT=0
# Mismo valor en el .env de cada sitio React. Sirve para publicar logos sin hacer deploy.
BRAND_PUSH_TOKEN=

# Bot de Telegram (avisos a administradores; vinculacion desde Perfil). Webhook: https://<dashboard>/bot/  -> php bot/set_webhook.php set https://<dashboard>/bot/
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 16 a 256 caracteres (letras, numeros, _ y -). Telegram lo envia en cada peticion; sin esto el webhook rechaza todo
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# API de front (web y app de clientes): /api/front/v1, carpeta api/front. Antes vivía en api.mie-commerce.com/front.
# Usa la misma base de datos y estas mismas llaves (DB_*, URL_SISTEMA, URL_UPLOAD, APP_ENV, TRACKING_SECRET, TELEGRAM_BOT_TOKEN).
# LLAVES NUEVAS, las únicas que hay que copiar del .env del API viejo al .env del dashboard:
# ---------------------------------------------------------------------------------------------------------------------
# Correos por API (Resend). DigitalOcean bloquea SMTP. MAIL_DRIVER: resend = envía de verdad | log = no envía, guarda en logs/<alias>/emails.log
MAIL_DRIVER=resend
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend; MAIL_REPLY_TO es adonde llegan las respuestas
MAIL_FROM=
MAIL_REPLY_TO=
# Solo local/pruebas: redirige TODOS los correos a esta dirección (vacío en producción)
MAIL_REDIRECT_TO=
# Google Maps (Places autocomplete/details y Routes para cotizar envíos)
API_GOOGLE_MAPS=
# MedianetPay: URL COMPLETA del webhook url_back (se envía tal cual). Ej: https://dashboard.tastelatam.com/webhooks/medianet_callback.php
MEDIANET_URL_BACK=
# IPs de Medianet autorizadas a llamar el callback, separadas por coma. Vacío = no valida IP
MEDIANET_ALLOWED_IPS=
# Opcionales (valores por defecto): versión que se guarda en la orden, dígitos del código de login por correo, y carpeta de imágenes fijas
# API_VERSION=v2
# LOGIN_EMAIL_NUM_DIGITS=4
# URL_RESOURCE=<URL_SISTEMA>assets/resource/api/
