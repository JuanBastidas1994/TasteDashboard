# Nuvei reintenta este webhook (hasta 48h) y ModSecurity lo esta bloqueando
# con 406 antes de que llegue a PHP (confirmado: no queda log en nuvei_pagos/
# para esos intentos). El endpoint ya valida el pago con stoken (hash),
# asi que desactivar el WAF solo para este archivo es seguro.
<FilesMatch "^nuvei_pago_complete\.php$">
    <IfModule mod_security2.c>
        SecRuleEngine Off
    </IfModule>
    <IfModule mod_security.c>
        SecFilterEngine Off
        SecFilterScanPOST Off
    </IfModule>
</FilesMatch>
